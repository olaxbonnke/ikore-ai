# Data
DATA_MODE=live
ZETARIS_REST_URL=
ZETARIS_BASE_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=5000
