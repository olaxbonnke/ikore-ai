# AI & Models: Primary Provider is Meterless Nightshift
# The NVIDIA API key is stored in Nightshift's Providers tab, not in this project.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=
METERLESS_APP=ikore-ai
METERLESS_SCOPE=
SAMPLE_MODE=false
# App
OKO_TZ=Africa/Lagos
OKO_STATE_DIR=.oko
OKO_DEMO_DATE=
APP_CONTACT_EMAIL=
